#: ../lib/GalettePaypal/Controllers/PaypalController.php:70
msgid "Paypal payment"
msgstr "Оплата Paypal"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:81
msgid ""
"<strong>Payment could not work</strong>: An error occurred (that has been "
"logged) while loading Paypal preferences from database.<br/>Please report "
"the issue to the staff."
msgstr ""
"<strong>Оплата не удалась</strong>: При загрузке параметров Paypal из БД "
"произошла ошибка (которая была зарегистрирована).<br/>Пожалуйста, сообщите "
"об этом сотрудникам."

#: ../lib/GalettePaypal/Controllers/PaypalController.php:82
msgid "Our apologies for the annoyance :("
msgstr "Приносим свои извинения за беспокойство :("

#: ../lib/GalettePaypal/Controllers/PaypalController.php:89
msgid ""
"Paypal id has not been defined. Please ask an administrator to add it from "
"plugin preferences."
msgstr ""
"Идентификатор Paypal не определен. Пожалуйста, попросите администратора "
"добавить его из настроек плагина."

#: ../lib/GalettePaypal/Controllers/PaypalController.php:144
#: ../lib/GalettePaypal/PluginGalettePaypal.php:56
msgid "Paypal History"
msgstr "История Paypal"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:207
msgid "Paypal Settings"
msgstr "Настройки Paypal"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:247
msgid "Paypal preferences has been saved."
msgstr "Параметры Paypal сохранены."

#: ../lib/GalettePaypal/Controllers/PaypalController.php:253
msgid "An error occurred saving paypal preferences :("
msgstr "Произошла ошибка при сохранении предпочтений paypal :("

#: ../lib/GalettePaypal/Controllers/PaypalController.php:274
msgid "Your payment has been aborted!"
msgstr "Ваш платеж был отменен!"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:299
msgid "Paypal payment success"
msgstr "Успех оплаты Paypal"

#: ../lib/GalettePaypal/Controllers/PaypalController.php:305
msgid "Your payment has been proceeded!"
msgstr "Ваш платеж был проведен!"

#: ../lib/GalettePaypal/PluginGalettePaypal.php:52
msgid "Paypal"
msgstr "Paypal"

#: ../lib/GalettePaypal/PluginGalettePaypal.php:83
#: ../lib/GalettePaypal/PluginGalettePaypal.php:107
msgid "Payment form"
msgstr "Форма оплаты"

#: ../tempcache/paypal_success.html.twig:62
msgid "Your paypal payment was successful. Some details are shown below:"
msgstr ""
"Ваш платеж через paypal прошел успешно. Некоторые детали приведены ниже:"

#: ../tempcache/paypal_success.html.twig:122
msgid ""
"Your paypal payment was successful. You may receive a mail from paypal with "
"details."
msgstr ""
"Ваш платеж через paypal прошел успешно. Вы можете получить письмо от paypal "
"с подробной информацией."

#: ../tempcache/paypal_preferences.html.twig:71
msgid "Cannot load the preferences"
msgstr "Невозможно загрузить предпочтения"

#: ../tempcache/paypal_preferences.html.twig:77
msgid "An error occurred while loading the preferences from the database."
msgstr "Произошла ошибка при загрузке предпочтений из БД."

#: ../tempcache/paypal_preferences.html.twig:81
msgid "Please, check if the plugin's database has been properly initialized."
msgstr "Пожалуйста, проверьте, правильно ли инициализирована БД плагина."

#: ../tempcache/paypal_preferences.html.twig:96
msgid "Paypal identifier:"
msgstr "Идентификатор Paypal:"

#: ../tempcache/paypal_preferences.html.twig:96
msgid ""
"Enter here one of your Paypal ID or email adress associated within your "
"paypal account."
msgstr ""
"Введите здесь один из ваших ID Paypal или адрес эл. почты, связанный с вашим "
"счетом paypal."

#: ../tempcache/paypal_preferences.html.twig:120
msgid "Amounts can be defined in the contributions types settings."
msgstr "Суммы можно определить в настройках типов взносов."

#: ../tempcache/paypal_preferences.html.twig:184
msgid "Error: no predefined amounts found."
msgstr "Ошибка: не найдено предопределенных сумм."

#: ../tempcache/paypal_form.html.twig:74
msgid "Enter payment reason"
msgstr "Введите причину платежа"

#: ../tempcache/paypal_form.html.twig:81
msgid "Payment reason"
msgstr "Основание платежа"

#: ../tempcache/paypal_form.html.twig:88
msgid "Select a payment reason"
msgstr "Выберите причину платежа"

#: ../tempcache/paypal_form.html.twig:183
msgid "Payment reason:"
msgstr "Причина оплаты:"

#: ../tempcache/paypal_form.html.twig:215
msgid "Pay with paypal"
msgstr "Оплата с помощью paypal"

#: ../tempcache/paypal_form.html.twig:271
#, php-format
msgid "Go back to %s's website to complete your inscription."
msgstr "Вернитесь на сайт %s, чтобы завершить надпись."

#: ../tempcache/paypal_form.html.twig:310
msgid "You have to select an option"
msgstr "Вам нужно выбрать вариант"

#: ../tempcache/paypal_form.html.twig:319
msgid "Please enter an amount."
msgstr "Пожалуйста, введите сумму."

#: ../tempcache/paypal_form.html.twig:325
msgid ""
"The amount you've entered is lower than the minimum amount for the selected "
"option.\n"
"Please choose another option or change the amount."
msgstr ""
"Введенная вами сумма меньше минимальной суммы для выбранного варианта.\n"
"Пожалуйста, выберите другой вариант или измените сумму."

#: ../tempcache/paypal_history.html.twig:89
#: ../tempcache/paypal_history.html.twig:235
msgid "Request"
msgstr "Запрос"

#: ../tempcache/paypal_history.html.twig:151
#: ../tempcache/paypal_history.html.twig:156
msgid "duplicate"
msgstr "дубликат"

#: ../tempcache/paypal_history.html.twig:197
msgid "No request or unable to read request"
msgstr "Нет запроса или невозможно прочитать запрос"

#: ../tempcache/paypal_history.html.twig:241
msgid "Show/hide full request"
msgstr "Показать/скрыть полный запрос"

