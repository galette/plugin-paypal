{% extends 'elements/list.html.twig' %}

{% set filters = paypal_history.filters %}

{% set states = {
    (constant("GalettePaypal\\PaypalHistory::STATE_NONE")): _T("Unknown", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_PROCESSED")): _T("Processed", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_DONE")): _T("Processed", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_ERROR")): _T("Error", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_INCOMPLETE")): _T("Incomplete", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_ALREADYDONE")): _T("Already processed", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_PENDING")): _T("Awaiting payment", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_CAPTURING")): _T("Capture in progress", "paypal"),
    (constant("GalettePaypal\\PaypalHistory::STATE_PUBLIC")): _T("Public donation", "paypal")
} %}

{% set form = {
    'order': {
        'name': "paypal_history"
    }
} %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%1$s entry", "%1$s entries", nb)|format(nb),
        'route': {
            'name': 'filter_paypal_history'
        }
    } %}
    {{ parent() }}
{% endblock %}

{% block header %}
    {% set no_action = true %}
    {% set columns = [
        {
            'label': '#',
            'collapse': true
        },
        {
            'label': _T("Date"), 'order': constant("Galette\\Filters\\HistoryList::ORDERBY_DATE"),
            'collapse': true
        },
        {
            'label': _T("Order", "paypal"),
            'collapse': true
        },
        {
            'label': _T("Name"),
            'collapse': true
        },
        {
            'label': _T("Subject"),
            'collapse': true
        },
        {
            'label': _T("Amount"),
            'collapse': true
        },
        {
            'label': _T("State", "paypal"),
            'collapse': true
        },
        {'label': _T("Request", "paypal")}
    ] %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% for log in logs %}
        <tr>
            <td class="collapsing" data-scope="row">
                {{ loop.index }}
                <span class="visually-hidden">
                    {{ _T("History entry %id")|replace({'%id': loop.index}) }}
                </span>
            </td>
            <td class="collapsing" data-col-label="{{ _T("Date") }}">
                {{ log.history_date|date(_T("Y-m-d H:i:s")) }}
            </td>
            <td class="collapsing" data-col-label="{{ _T("Order", "paypal") }}">
                <code>{{ log.order_id }}</code>
            </td>
            <td class="collapsing" data-col-label="{{ _T("Name") }}">
        {% if log.id_adh is not empty %}
                <a href="{{ url_for("member", {"id": log.id_adh}) }}">{{ log.member_fullname }}</a>
        {% else %}
                {{ _T("Anonymous", "paypal") }}
        {% endif %}
            </td>
            <td class="collapsing" data-col-label="{{ _T("Subject") }}">
                {{ log.comments }}
            </td>
            <td class="collapsing" data-col-label="{{ _T("Amount") }}">
                {{ log.amount|format_currency(log.currency, {}, galette_lang) }}
            </td>
            <td class="collapsing" data-col-label="{{ _T("State", "paypal") }}">
                {{ states[log.state] ?? log.state }}
            </td>
            <td data-col-label="{{ _T("Request", "paypal") }}">
                <details class="ui basic styled accordion">
                    <summary class="title">
                        <i class="caret down icon" aria-hidden="true"></i> {{ _T("Show/hide full request", "paypal") }}
                    </summary>
                    <div class="content">
                        <pre>{{ log.raw_request }}</pre>
                    </div>
                </details>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="8" class="emptylist">{{ _T("logs are empty") }}</td></tr>
    {% endfor %}
{% endblock %}

{% block javascripts %}
        <script type="text/javascript">
            $('#nbshow').change(function() {
                this.form.submit();
            });
        </script>
{% endblock %}
