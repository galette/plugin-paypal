{% extends not login.isLogged() ? "public_page.html.twig" : "page.html.twig" %}

{% block content %}
    {% if paypal.isLoaded() and paypal.isConfigured() %}
        <form action="{{ url_for("paypal_formCheckout") }}" method="post" id="paypalform" class="ui form">
            <div class="ui top attached accordion-styled header">
                {% if amounts|length == 0 %}
                    {{ _T("Enter payment reason", "paypal") }}
                {% elseif amounts|length == 1%}
                    {{ _T("Payment reason", "paypal") }}
                {% elseif amounts|length > 1 %}
                    {{ _T("Select a payment reason", "paypal") }}
                {% endif %}
            </div>
            <div class="ui bottom attached accordion-styled segment">
                <div class="active content field">
                    <div class="field inline">
                        {% if amounts|length > 0 %}
                                <div class="grouped fields">
                                    {% for k, amount in amounts %}
                                        <div class="field">
                                            <div class="ui radio checkbox">
                                                <input type="radio" name="item_id" id="in{{ k }}" value="{{ k }}"{% if loop.index0 == 0 %} checked="checked"{% endif %}/>
                                                <label for="in{{ k }}"><span id="in{{ k }}_name" data-amount="{{ amount['amount'] }}">{{ amount['name'] }}</span>
                                                    {% if amount['amount'] > 0 %}
                                                        ({{ amount['amount']|format_currency(paypal.getCurrency(), {}, galette_lang) }})
                                                    {% endif %}
                                                </label>
                                            </div>
                                            {% if amount['description'] is defined and amount['description'] is not empty %}
                                                <div class="ui visible info message amount-description">{{ amount['description']|raw }}</div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                        {% else %}
                                <p>{{ _T("Error: no predefined amounts found.", "paypal") }}</p>
                        {% endif %}
                    </div>

                    {% include "components/forms/text.html.twig" with {
                        id: 'amount',
                        value: amounts|length > 0 ? amounts|first.amount : 20,
                        label: _T("Amount"),
                        required: true
                    } %}
                </div>
            </div>

            <div class="ui basic center aligned fitted segment">
                <button type="submit" name="valid" class="action ui labeled icon primary button"{% if login.isSuperAdmin() or amounts|length == 0 %} disabled{% endif %}>
                    <i class="paypal icon"></i> {{ _T("Pay with paypal", "paypal") }}
                </button>
            </div>
        </form>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% if paypal.isLoaded() and paypal.isConfigured() and amounts|length > 0 %}
        <script type="text/javascript">
            $(function() {
                $('input[name="item_id"]').change(function(){
                    var _amount = parseFloat($('#' + this.id + '_name').data('amount'));
                    if ( _amount != '' && !isNaN(_amount) ) {
                        $('#amount').val(_amount);
                    }
                });
                $('#paypalform').submit(function(e) {
                    var _checked = $('input[name="item_id"]:checked');
                    if (_checked.length == 0 ) {
                        alert("{{ _T("You have to select an option", "paypal")|e('js') }}");
                        return false;
                    } else {
                        var _current_amount = parseFloat($('#amount').val());
                        var _amount = parseFloat($('#' + _checked[0].id + '_name').data('amount'));
                        if ( isNaN(_current_amount) ) {
                            alert("{{ _T("Please enter an amount.", "paypal")|e('js') }}");
                            return false;
                        } else if ( !isNaN(_amount) && _current_amount < _amount ) {
                            alert("{{ _T("The amount you've entered is lower than the minimum amount for the selected option.\nPlease choose another option or change the amount.", "paypal")|e('js') }}");
                            return false;
                        }
                    }
                    return true;
                });
            });
        </script>
    {% endif %}
{% endblock %}
