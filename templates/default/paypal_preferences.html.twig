{% extends 'page.html.twig' %}

{% block content %}
    <form action="{{ url_for("store_paypal_preferences") }}" method="post" enctype="multipart/form-data" class="ui form">
        {% if not paypal.isLoaded() %}
            <div id="errorbox" class="ui error icon visible message">
                <i class="exclamation circle icon" aria-hidden="true"></i>
                <div class="content">
                    <div class="header">
                        {{ _T("Cannot load the preferences", "paypal") }}
                    </div>
                    <p>
                        {{ _T("An error occured while loading the preferences from the database.", "paypal") }}<br/>
                        {{ _T("Please, check if the plugin's database has been properly initialized.", "paypal") }}
                    </p>
                </div>
            </div>
        {% endif %}
        <div class="ui segment">
            {% if login.isAdmin() %}
                <div class="inline field">
                    <label>{{ _T("Paypal webhook endpoint URL", "paypal") }} :</label>
                    <code>{{ webhook_url }}</code>
                </div>
                <div class="inline field">
                    <label>{{ _T("Paypal webhook events", "paypal") }} :</label>
                    <code>CHECKOUT.ORDER.APPROVED</code>, <code>PAYMENT.CAPTURE.COMPLETED</code>
                </div>

                {% include "components/forms/text.html.twig" with {
                    id: 'paypal_client_id',
                    value: paypal.getClientId(),
                    label: _T("Paypal client identifier", "paypal"),
                    required: true,
                    tip: _T("Enter here the client ID of the REST application created from your Paypal developer dashboard.", "paypal")
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'paypal_client_secret',
                    value: paypal.getClientSecret(),
                    label: _T("Paypal client secret", "paypal"),
                    required: true,
                    tip: _T("Enter here the secret of the REST application created from your Paypal developer dashboard.", "paypal")
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'paypal_webhook_id',
                    value: paypal.getWebhookId(),
                    label: _T("Paypal webhook identifier", "paypal"),
                    required: true,
                    tip: _T("Enter here the identifier of the webhook you declared on the above URL. It is required to check notifications authenticity.", "paypal")
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'paypal_currency',
                    value: paypal.getCurrency(),
                    label: _T("Currency", "paypal"),
                    required: true,
                    tip: _T("Three letters ISO 4217 currency code, such as EUR or CHF.", "paypal")
                } %}

                {% include "components/forms/checkbox.html.twig" with {
                    id: 'paypal_sandbox',
                    value: 1,
                    checked: paypal.isSandbox(),
                    label: _T("Sandbox mode", "paypal"),
                    tip: _T("Use Paypal sandbox rather than the real thing. Credentials from your sandbox application are then required.", "paypal")
                } %}
            {% endif %}

    {% if paypal.isLoaded() and amounts|length > 0 %}
                <table class="listing ui celled striped table">
                    <thead>
                        <tr>
                            <th class="listing">{{ _T("Contribution type") }}</th>
                            <th class="listing collapsing">
                                {{ _T("Amount") }}
                                <i class="circular small basic question icon tooltip" aria-hidden="true" title="{{ _T("Amounts can be defined in the contributions types settings.", "paypal") }}"></i>
                            </th>
                            <th class="listing collapsing">{{ _T("Inactive") }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for k, amount in amounts %}
                            <tr>
                                <td>
                                    <label for="inactives_{{ k }}">{{ amount['name'] }}</label>
                                </td>
                                <td class="collapsing">
                                    {{ amount['amount'] }}
                                </td>
                                <td class="collapsing">
                                    <div class="ui right aligned toggle checkbox">
                                        <input type="checkbox" name="inactives[]" id="inactives_{{ k }}"{% if paypal.isInactive(k) %} checked="checked"{% endif %} value="{{ k }}"/>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>{{ _T("Error: no predefined amounts found.", "paypal") }}</p>
            {% endif %}
        </div>

        <div class="ui basic center aligned segment">
            <button type="submit" class="ui labeled icon primary button action">
                <i class="save icon"></i> {{ _T("Save") }}
            </button>
            <input type="hidden" name="valid" value="1"/>
        </div>
    </form>
{% endblock %}
